# --- Server ---
PORT=4000

# --- Speech-to-text: self-hosted Whisper (docker compose up -d from the project root) ---
WHISPER_ASR_URL=http://localhost:9000

# --- Interpretation + translation LLM ---
# "gemini" = Google's FREE-tier API (runs on Google's servers; recommended for a 12GB CPU-only PC)
# "ollama" = fully local (needs a strong machine; a 7B model froze a 12GB CPU-only PC)
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Minimum milliseconds between LLM calls (protects the free-tier rate limit; 7000 ≈ 8 req/min)
LLM_MIN_INTERVAL_MS=7000

# Request timeouts (ms)
WHISPER_TIMEOUT_MS=60000
LLM_TIMEOUT_MS=30000
