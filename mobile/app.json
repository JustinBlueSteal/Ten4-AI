{
  "expo": {
    "name": "Ten4 Text",
    "slug": "ten4-text",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ten4text.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ten4 Text uses your location once to suggest the emergency radio feeds nearest you."
      }
    },
    "android": {
      "package": "com.ten4text.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        { "locationWhenInUsePermission": "Ten4 Text uses your location once to suggest the emergency radio feeds nearest you." }
      ]
    ],
    "web": { "favicon": "./assets/favicon.png" }
  }
}
